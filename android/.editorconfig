# ktlint (official Kotlin coding conventions), like SamsungHealthReporter
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 4

[*.{kt,kts}]
max_line_length = 120
ij_kotlin_allow_trailing_comma = true
ij_kotlin_allow_trailing_comma_on_call_site = true
ktlint_code_style = ktlint_official
# One Extensions+<Type>.kt file per extended type
ktlint_standard_filename = disabled
# com.kvs.samsung_health_reporter: Flutter names the plugin package after the pub package
ktlint_standard_package-name = disabled
